{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon AppFlow Connectors Tags API",
    "version": "2020-08-23"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon AppFlow List Tags for Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://appflow.{region}.amazonaws.com/tags/:resourceArn",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the specified flow."
              }
            ]
          },
          "docs": "Retrieves the tags that are associated with a specified flow."
        },
        {
          "info": {
            "name": "Amazon AppFlow Tag Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://appflow.{region}.amazonaws.com/tags/:resourceArn",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the flow that you want to tag."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Applies a tag to the specified flow."
        },
        {
          "info": {
            "name": "Amazon AppFlow Untag Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://appflow.{region}.amazonaws.com/tags/:resourceArn#tagKeys",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the flow that you want to untag."
              },
              {
                "name": "tagKeys",
                "value": "",
                "type": "query",
                "description": "The tag keys associated with the tag that you want to remove from your flow."
              }
            ]
          },
          "docs": "Removes a tag from the specified flow."
        }
      ]
    }
  ],
  "bundled": true
}